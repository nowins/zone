<?xml version="1.0" encoding="utf-8"?>
<!--
  Zone 的 MSIX 打包清单。

  上架商店前必须修改（来自 Partner Center 应用“产品标识”页）：
    - Identity/@Name        -> 保留应用名称后分配的包标识
    - Identity/@Publisher   -> Partner Center 的发布者 DN（形如 CN=AAAA-BBBB-...）
    - Properties/PublisherDisplayName
  版本号由 packaging/build-msix.ps1 在打包时按 tauri.conf.json 自动盖章（四段式）。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="ZonePlayer"
    Version="1.0.0.0"
    Publisher="CN=Zone Project"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Zone</DisplayName>
    <PublisherDisplayName>Zone Project</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Zune 风格的本地音乐播放器：本地曲库、播客、逐词歌词与封面拼贴正在播放页。</Description>
  </Properties>

  <Resources>
    <Resource Language="zh-CN" />
    <Resource Language="en-US" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26200.0" />
  </Dependencies>

  <Applications>
    <Application Id="Zone" Executable="zone-player.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Zone"
        Description="Zune 风格的本地音乐播放器"
        BackgroundColor="#1B1A19"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Square310x310Logo="Assets\Square310x310Logo.png"
          Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#1B1A19" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
