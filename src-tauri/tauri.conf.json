{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zone",
  "version": "0.1.0",
  "identifier": "com.zone.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zone",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 620,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "center": true,
        "additionalBrowserArgs": "--disable-features=HardwareMediaKeyHandling"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Zone Project",
    "copyright": "Copyright © 2026 Zone Project",
    "category": "Music",
    "shortDescription": "Zune 风格的本地音乐播放器",
    "longDescription": "Zone 是一款受 Microsoft Zune 4.8 启发的本地音乐播放器：Zune 风格界面、本地曲库与播客、逐行/逐词同步歌词、封面拼贴正在播放页。",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}

