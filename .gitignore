build/
dist/
out/

# 环境变量文件（敏感信息）
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# 日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 编辑器 / 工具缓存
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ---------------
# Tauri 核心相关
# ---------------
src-tauri/target/
src-tauri/gen/
src-tauri/.cargo/

# Tauri 构建的安装包/可执行文件
src-tauri/release/
src-tauri/debug/

# Rust 依赖缓存
Cargo.lock
