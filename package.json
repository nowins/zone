{
  "name": "zone-player",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node packaging/check-version.mjs && tsc && vite build",
    "version:set": "node packaging/check-version.mjs --set",
    "test": "npm run test:visualizer",
    "test:visualizer": "node packaging/check-version.mjs && tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:store": "tauri build --config src-tauri/tauri.microsoftstore.conf.json --bundles nsis",
    "package:msix": "powershell -ExecutionPolicy Bypass -File packaging/build-msix.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
