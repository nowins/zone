{
  "name": "zone-player",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0" },
  "scripts": {
    "dev": "vite",
    "build": "node packaging/check-version.mjs && tsc && vite build",
    "version:set": "node packaging/check-version.mjs --set",
    "test": "npm run test:visualizer",
    "test:visualizer": "node packaging/check-version.mjs && tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:store": "powershell -ExecutionPolicy Bypass -File packaging/build-store.ps1",
    "release:check": "powershell -ExecutionPolicy Bypass -File packaging/build-store.ps1 -ValidateOnly",
    "audit:release": "npm audit && node packaging/check-rust-audit.mjs",
    "notices:generate": "node packaging/generate-notices.mjs",
    "package:msix": "powershell -ExecutionPolicy Bypass -File packaging/build-msix.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  }
}
