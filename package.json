{
  "name": "zone-player",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node packaging/check-version.mjs && tsc && vite build",
    "version:set": "node packaging/check-version.mjs --set",
    "test": "npm run test:visualizer",
    "test:visualizer": "node packaging/check-version.mjs && tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "build:ci:native": "node scripts/ci/build-native.mjs",
    "test:ci:artifact": "node tests/run-native-artifact.mjs",
    "test:ci:faults": "node tests/run-native-artifact.mjs --faults",
    "test:ci:baselines": "node tests/run-native-artifact.mjs --baselines",
    "qa:compare-baselines": "node scripts/qa/compare-native-baselines.mjs",
    "qa": "node scripts/qa/run.mjs",
    "perf:library": "node --expose-gc scripts/perf/library-model.mjs",
    "perf:search": "node --expose-gc scripts/perf/library-paired.mjs",
    "perf:native": "cargo test --manifest-path src-tauri/Cargo.toml --locked --release --lib music::performance_observation::generated_library_observation -- --exact --ignored --nocapture --test-threads=1",
    "test:podcast:stability": "node tests/run-podcast-stability.mjs",
    "test:podcast:client": "node tests/run-podcast-client.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:store": "powershell -ExecutionPolicy Bypass -File packaging/build-store.ps1",
    "release:check": "powershell -ExecutionPolicy Bypass -File packaging/build-msix.ps1 -ForStore -ValidateOnly",
    "release:check:nsis": "powershell -ExecutionPolicy Bypass -File packaging/build-store.ps1 -ValidateOnly",
    "audit:release": "npm audit && node packaging/check-rust-audit.mjs",
    "notices:generate": "node packaging/generate-notices.mjs",
    "package:msix": "powershell -ExecutionPolicy Bypass -File packaging/build-msix.ps1",
    "package:msix:store": "powershell -ExecutionPolicy Bypass -File packaging/build-msix.ps1 -ForStore",
    "test:msix:hyperv": "powershell -ExecutionPolicy Bypass -File packaging/test-msix-hyperv.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  }
}
